<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados</title>
</head>
<body>
{{> header}}

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="bg-danger text-white card-body border-light border-opacity-50 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h1 class="display-5 fw-bold mb-1">
                            Preguntas Reportadas
                        </h1>
                        <p class="lead mb-0 text-light">
                            Gestiona los reportes emitidos por los usuarios de la plataforma. </p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/panelEditor/mostrar" class="btn btn-outline-light btn-lg">
                            Volver al Panel</a>
                    </div>
                </div>
            </div>

            {{#hubo_reportes}}
                <div class="shadow-sm border-0">
                    <div class="table-ticket-wrap">
                        <table class="table table-ticket align-middle mb-0">
                            <thead class="table-dark text-uppercase fs-7">
                            <tr>
                                <th scope="col" class="ps-4 py-3" style="width: 45%;">Pregunta</th>
                                <th scope="col" class="py-3" style="width: 15%;">Categoría</th>
                                <th scope="col" class="py-3" style="width: 15%;">Motivo del Reporte</th>
                                <th scope="col" class="pe-4 py-3 text-end" style="width: 25%;">Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#lista_reportes}}
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="fw-semibold text-dark fs-5 d-block mb-1">{{texto}}</span>
                                        <div class="mt-2 d-flex flex-wrap gap-2">
                                            {{#respuestas}}
                                                <span class="badge {{#es_correcta}}bg-success{{/es_correcta}}{{^es_correcta}}bg-secondary{{/es_correcta}}">
                                                    {{texto}}
                                                </span>
                                            {{/respuestas}}
                                        </div>
                                    </td>

                                    <td class="py-3">
                                <span class="badge px-3 py-2 text-white" style="background-color: {{color}};">
                                    {{nombre}}
                                </span>
                                    </td>

                                    <td class="py-3">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-2">
                                    {{reportado}}
                                </span>
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex flex-column text-center flex-md-row gap-2 justify-content-end">

                                            <form action="/panelEditor/verEditarPregunta" method="POST" class="m-0">
                                                <input type="hidden" name="id" value="{{id}}">
                                                <input type="hidden" name="redirect" value={{redirect}}>
                                                <button type="submit"
                                                        class="btn btn-sm btn-warning fw-bold d-inline-flex align-items-center gap-1"
                                                        title="Editar contenido o respuestas">
                                                    Editar
                                                </button>
                                            </form>

                                            <form action="/panelEditor/ignorarPregunta" method="POST" class="m-0">
                                                <input type="hidden" name="id" value="{{id}}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success fw-bold d-inline-flex align-items-center gap-1"
                                                        title="Descartar reporte">
                                                    Ignorar
                                                </button>
                                            </form>

                                            <form action="/panelEditor/eliminarPregunta" method="POST" class="m-0"
                                                  onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta pregunta de forma permanente?');">
                                                <input type="hidden" name="id_pregunta" value="{{id}}">
                                                <input type="hidden" name="redirect" value={{redirect}}>
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger fw-bold d-inline-flex align-items-center gap-1"
                                                        title="Eliminar pregunta de la aplicación">
                                                    Eliminar
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            {{/lista_reportes}}
                            </tbody>
                        </table>
                    </div>
                </div>
            {{/hubo_reportes}}

            {{^hubo_reportes}}
                <div class="card text-center shadow-sm border-0">
                    <div class="card-body p-5">
                        <div class="display-1 mb-3">🎉</div>
                        <h3 class="fw-bold text-rosa">¡Todo al día por aquí!</h3>
                        <p class="text-light mb-0">No se encontraron preguntas con reportes activos en este momento.</p>
                    </div>
                </div>
            {{/hubo_reportes}}

        </div>
    </div>
</main>

{{> footer}}
</body>
</html>