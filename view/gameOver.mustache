<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Fin del Juego</title>
</head>
<body class="bg-light">
{{> header}}

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card shadow p-5 border-0 row-gap-3">
                <div class="display-1 text-danger">💀</div>
                <h1 class="fw-bold text-dark">¡Fin del Juego!</h1>
                {{#hubo_respuestas}}
                    <h3>Preguntas que respondiste correctamente en esta partida:</h3>
                    <ul class="lista-respondidas">
                        {{#historial_preguntas}}
                            <li>
                                <strong>📌 {{texto}}</strong>
                                <span class="badge" style="background-color: {{categoria_color}};">
                                   ({{categoria_nombre}})
                                </span>
                            </li>
                        {{/historial_preguntas}}
                    </ul>
                {{/hubo_respuestas}}

                {{^hubo_respuestas}}
                    <p>No lograste responder ninguna pregunta correctamente esta vez. ¡A intentarlo de nuevo!</p>
                {{/hubo_respuestas}}

                <hr class="my-4">

                <div class="d-grid gap-2">
                    <a href="/index.php?controller=pregunta&method=list" class="btn btn-primary btn-lg">
                        🔄 Intentar de nuevo
                    </a>
                    <a href="/index.php?controller=lobby&method=list" class="btn btn-outline-secondary">
                        🏠 Volver al Lobby
                    </a>
                </div>
            </div>

        </div>
    </div>
</main>

{{> footer}}
</body>
</html>