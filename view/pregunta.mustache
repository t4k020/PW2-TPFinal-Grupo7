<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Jugando</title>
</head>
<body>
{{> header}}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-0">

                <div class="card-header text-white text-center py-3" style="background-color: {{categoria_color}};">
                    <span class="badge bg-light text-dark uppercase fw-bold px-3 py-2">
                        {{categoria_nombre}}
                    </span>
                </div>

                <div class="card-body text-center p-4">
                    <h3 class="card-title my-4 fw-semibold">
                        {{texto}}
                    </h3>

                    <hr class="my-4">

                    <div class="d-grid gap-3">
                        {{#respuestas}}
                            <a href="/index.php?controller=pregunta&method=evaluar&id_respuesta={{id}}"
                            class="btn btn-outline-secondary btn-lg text-start px-4 py-3 shadow-sm generic-answer-btn">
                            {{texto}}
                            </a>
                        {{/respuestas}}
                    </div>
                </div>

            </div>

        </div>
    </div>
</main>

{{> footer}}
</body>
</html>