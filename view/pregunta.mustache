<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Jugando</title>
</head>
<body>
{{> header}}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-0">

                <div class="card-header text-white text-center py-3 rounded-0 mb-1" style="background-color: {{categoria_color}};">
                    <span class="badge bg-light text-dark uppercase fw-bold px-3 py-2">
                        {{categoria_nombre}}
                    </span>
                </div>

                <div class="card-body text-center p-4">
                    <div>
                        {{#ya_reportada}}
                            <span style="color: green; font-weight: bold; font-size: 0.9rem;">✔️ ¡Reportada!</span>
                        {{/ya_reportada}}

                        {{^ya_reportada}}
                            <button type="button" onclick="conmutarFormulario({{id}})" title="Reportar pregunta"
                                    style="background: none; border: none; color: red; font-size: 1.3rem; cursor: pointer;">
                                🚩
                            </button>
                        {{/ya_reportada}}
                        {{^ya_reportada}}
                            <form id="form-reporte-{{id}}" action="/Pregunta/iniciarReporte" method="POST"
                                  style="display: none; margin-top: 12px; background: #fff; padding: 10px; border-left: 3px solid red;">
                                <input type="hidden" name="id_pregunta_reportada" value="{{id}}">
                                <input type="hidden" name="origen" value="lista_preguntas">

                                <label for="motivo-{{id}}" class="text-dark">¿Cuál es el problema?</label>
                                <div class="d-flex flex-column flex-md-row gap-2">
                                    <select name="motivo_reporte" id="motivo-{{id}}" required
                                            style="padding: 5px; flex-grow: 1;">
                                        <option value="Respuesta equivocada">Respuesta equivocada</option>
                                        <option value="Pregunta mal escrita">Pregunta mal escrita</option>
                                    </select>
                                    <button type="submit" class="btn btn-danger btn-lg">Enviar Reporte</button>
                                </div>
                            </form>
                        {{/ya_reportada}}
                    </div>
                    <h3 class="card-title text-light my-4 fw-semibold">
                        {{texto}}
                    </h3>
                    <div class="d-flex justify-content-center">
                        <div id="timer" class="badge  fs-4 text-dark"
                             style="background-color: {{categoria_color}};">
                            {{tiempo_restante}}
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-3">
                        {{#respuestas}}
                            <a href="/Pregunta/evaluar?id_respuesta={{id}}"
                            class="btn puntaje btn-lg text-start px-4 py-3 shadow-sm generic-answer-btn">
                            {{texto}}
                            </a>
                        {{/respuestas}}
                    </div>

                    <div class="mt-5 text-center">
                        <button onclick="confirmarSalida()" class="btn btn-danger btn-sm px-4">
                            Terminar Partida
                        </button>
                    </div>
                </div>

            </div>

        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

{{> footer}}
<script>
    function conmutarFormulario(id) {
        var formulario = document.getElementById('form-reporte-' + id);
        if (formulario.style.display === 'none') {
            formulario.style.display = 'block';
        } else {
            formulario.style.display = 'none';
        }
    }

    //Sirve para poner un pop-up de confirmacion al boton de terminar partida, se integra con la libreria SweetAlert2
    function confirmarSalida() {
        Swal.fire({
            title: '¿Abandonar partida?',
            text: "Se guardará tu puntaje, pero cortarás tu racha actual.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33', // Rojo peligro
            cancelButtonColor: '#6c757d', // Gris secundario
            confirmButtonText: 'Sí, salir',
            cancelButtonText: 'Seguir jugando',
            background: '#ffffff', // Fondo limpio
            borderRadius: '15px'
        }).then((result) => {
            // Si el jugador toca el botón rojo de confirmar...
            if (result.isConfirmed) {
                // ... Recién ahí lo mandamos al controlador
                window.location.href = '/pregunta/terminarPartida';
            }
        });
    }

    let tiempo = {{tiempo_restante}};

    const timer = document.getElementById("timer");

    const intervalo = setInterval(() => {

        timer.textContent = tiempo;

        if (tiempo <= 0) {
            clearInterval(intervalo);

            window.location.href = "/Pregunta/evaluar?timeout=1";
        }

        tiempo--;

    }, 1000);


</script>
</body>
</html>