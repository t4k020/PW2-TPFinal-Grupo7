<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <title>Perfil - {{Usuario.username}}</title>
</head>
<body>

{{> header}}

<main class="container py-4">

    <div class="row g-4">

        <!-- PERFIL -->
        <div class="col-lg-4">
            <div class="card shadow h-auto pb-4">
                <div class="card-body text-center">

                    <img src="/public/img/{{Usuario.fotoPerfil}}"
                         class="rounded-circle mb-3"
                         width="140"
                         height="140"
                         alt="Perfil">

                    <h3 class="mb-1">{{Usuario.nombreCompleto}}</h3>
                    <p class="text-muted">@{{Usuario.username}}</p>
                    <hr>
                    <h5 class="text-primary">{{Usuario.puntaje}} pts</h5>

                    {{#Usuario.qr}}
                        <hr>
                        <div class="mt-3">
                            <p class="mb-2"><strong>Mi QR</strong></p>

                            <img src="/public/img/qr/{{Usuario.qr}}"
                                 alt="QR del perfil"
                                 class="img-fluid"
                                 style="max-width: 180px;">
                        </div>
                    {{/Usuario.qr}}

                </div>
            </div>
        </div>

        <!-- INFO DETALLADA -->
        <div class="col-lg-8">

            <div class="card shadow mb-4">
                <div class="card-body">
                    <h4 class="mb-3">Información del usuario</h4>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <strong>Año de nacimiento</strong><br>
                            {{Usuario.anioNacimiento}}
                        </div>

                        <div class="col-md-6">
                            <strong>Sexo</strong><br>
                            {{Usuario.sexo}}
                        </div>

                        <div class="col-12">
                            <strong>Email</strong><br>
                            {{Usuario.mail}}
                        </div>

                        <div id="mapa" data-ciudad="{{Usuario.ciudad}}"
                             data-pais="{{Usuario.pais}}"></div>

                    </div>
                </div>
            </div>

            <!-- Partidas jugadas -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <h4 class="mb-3">Partidas jugadas</h4>

                    <div class="row">
                        <div class="col-md-4 text-center">
                            <strong class="text-muted">Partida</strong>
                            <p class="text-muted mb-0">
                                #{{Partida.id}}
                            </p>
                        </div>

                        <div class="col-md-4 text-center">
                            <strong class="text-muted">Preguntas Correctas</strong>
                            <p class="text-primary mb-0">
                                {{Partida.preguntasCorrectas}}
                            </p>
                        </div>

                        <div class="col-md-4 text-center">
                            <strong class="text-muted">Puntos Ganados</strong>
                            <p class="text-success mb-0">
                                {{Partida.puntosGanados}}
                            </p>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

</main>

</body>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/public/js/mapaPerfil.js"></script>
</html>