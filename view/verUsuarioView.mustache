<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <title>Perfil - {{Usuario.username}}</title>
</head>
<body>

{{> header}}

<main class="container py-4">

    <div class="row g-4">

        <!-- PERFIL -->
        <div class="col-lg-4">
            <div class="card shadow h-auto">
                <div class="card-body text-light text-center">

                    <div class="fotoperfil-arcoiris mx-auto mb-3">
                        <img src="/public/img/{{Usuario.fotoPerfil}}"
                             class="fotoperfil"
                             width="120"
                             height="120"
                             alt="Perfil">
                    </div>

                    <h3 class="mb-1">{{Usuario.nombreCompleto}}</h3>
                    <div class="mb-2 pb-4 mx-3">
                        <p class="mb-2 text-rosa">@{{Usuario.username}}</p>
                        <span class="btn-dorado no-hover fs-6 mb-3 py-1 px-3">⭐ {{Usuario.maestria}}</span>
                        <h5 class="p-2 mx-4 text-cyan fs-2">Total: {{puntaje}} pts</h5>

                        {{#Usuario.qr}}
                            <div class="puntaje pt-2 pb-4 mx-2 mt-3">
                                <p class="mb-2"><strong>Mi QR</strong></p>

                                <img src="/public/img/qr/{{Usuario.qr}}"
                                     alt="QR del perfil"
                                     class="img-fluid">
                            </div>
                        {{/Usuario.qr}}

                    </div>
                </div>
            </div>
        </div>

        <!-- INFO DETALLADA -->
        <div class="col-lg-8">

            <div class="card text-light shadow mb-4">
                <div class="card-body">
                    <h4 class="mb-3 text-rosa">Información del usuario</h4>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <strong class="text-cyan">Año de nacimiento</strong><br>
                            {{Usuario.anioNacimiento}}
                        </div>

                        <div class="col-md-4">
                            <strong class="text-cyan">Sexo</strong><br>
                            {{Usuario.sexo}}
                        </div>

                        <div class="col-md-4">
                            <strong class="text-cyan">Email</strong><br>
                            {{Usuario.mail}}
                        </div>

                        <div id="mapa" data-ciudad="{{Usuario.ciudad}}"
                             data-pais="{{Usuario.pais}}"></div>

                    </div>
                </div>
            </div>

            <!-- PARTIDAS JUGADAS -->
            <div class="puntaje shadow text-center mb-4">

                <h4 class="text-rosa my-3">PARTIDAS JUGADAS</h4>

                <div class="row text-center fw-bold text-light pb-2 mb-2">
                    <div class="col-4">Partida</div>
                    <div class="col-4">Puntos</div>
                    <div class="col-4">Fecha y Hora</div>
                </div>

                {{#Partidas}}
                    <div class="row text-center align-items-center border-top py-2 mx-3">

                        <div class="col-4 text-secondary">#{{id}}</div>
                        <div class="col-4 fw-bold">{{puntaje}} pts</div>
                        <div class="col-4 small text-primary">{{fecha_partida}}</div>

                    </div>
                {{/Partidas}}

                {{^Partidas}}
                    <p class="text-muted text-center mb-0">Este usuario todavía no jugó partidas.</p>
                {{/Partidas}}

            </div>
        </div>
    </div>

</main>

</body>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/public/js/mapaPerfil.js"></script>
</html>