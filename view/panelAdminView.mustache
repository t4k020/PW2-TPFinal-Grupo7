<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/public/css/lobby.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Lobby</title>
</head>
<body>
{{> header}}
<main class="container py-4">

    <div class="row g-4">

        <div class="col-lg-3">
            <div class="card shadow h-100 border-warning">
                <div class="card-body text-center">
                    <img src="/public/img/default-user.png"
                         class="rounded-circle mb-3 border border-3 border-warning"
                         width="120"
                         height="120"
                         alt="Admin Perfil">

                    <h4>{{usuario}}</h4>
                    <span class="badge bg-warning text-dark mb-3">Administrador</span>

                    <a href="/lobby" class="btn btn-outline-secondary btn-sm w-100">
                        🏠 Volver al Lobby
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">

            <div class="card shadow mb-4 position-relative">

                <div class="position-absolute top-0 end-0 m-3 d-none d-md-block">

                </div>

                <div class="card-body text-center py-5">
                    <h2 class="mb-3">📝 Ver preguntas propuestas</h2>
                    <p class="lead">
                        Preguntas propuestas por la comunidad esperando revisión.
                    </p>

                    <a href="/admin/revisarSugeridas"
                       class="btn btn-warning btn-lg px-5 fw-bold">
                        REVISAR PREGUNTAS
                    </a>

                    <div class="mt-3 d-md-none">
                        <a href="/admin/estadisticas"
                           class="btn btn-info text-white btn-lg px-4">
                            📊 Ver Gráficos
                        </a>
                    </div>
                </div>

            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <h4>🚨 Preguntas Reportadas</h4>
                            <br>

                            <a href="/PanelAdmin/verReportes"
                               class="btn btn-danger">
                                Gestionar Reportes
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <h4> 📊 Ver Estadisticas</h4>

                            <p class="lead">
                                e impresion de reporte
                            </p>

                            <a href="/admin/estadisticas"
                               class="btn btn-info text-white btn-lg shadow">
                                Ver datos
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</main>
</body>