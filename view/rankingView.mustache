<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Ranking</title>
</head>
<body>
{{> header}}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="shadow">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h2 class="mb-0"><i class="fas fa-trophy text-warning me-2"></i> Ranking Global de Jugadores</h2>
                </div>
                <div class="table-ticket-wrap p-0">
                    <table class="table table-ticket overflow-hidden table-striped mb-0 text-center">
                        <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 20%">Posición</th>
                            <th scope="col" style="width: 20%">Foto</th>
                            <th scope="col" style="width: 40%" class="text-start">Usuario</th>
                            <th scope="col" style="width: 20%">Puntaje Total</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#usuarios}}
                            <tr class="align-middle">
                                <td>
                                    <strong class="fs-5">{{puesto}}</strong>
                                </td>
                                <td>
                                    <a href="/usuario/ver/{{username}}">
                                        <img src="/public/img/{{fotoPerfil}}"
                                             class="rounded-circle border"
                                             width="45"
                                             height="45"
                                             alt="Avatar">
                                    </a>
                                </td>
                                <td class="text-start fw-bold">
                                    <a href="/usuario/ver/{{username}}" class="text-decoration-none text-rosa">{{username}}</a>
                                </td>
                                <td>
                                    <span class="badge bg-success fs-6 px-3 py-2">{{puntaje_total}} pts</span>
                                </td>
                            </tr>
                        {{/usuarios}}

                        {{^usuarios}}
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    ¡Todavía no hay registros de partidas! Sé el primero en jugar.
                                </td>
                            </tr>
                        {{/usuarios}}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-center py-3">
                    <a href="/lobby" class="btn btn-cyan">
                        <i class="fas fa-arrow-left me-2"></i>Volver al Lobby
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{> footer}}
</body>
</html>