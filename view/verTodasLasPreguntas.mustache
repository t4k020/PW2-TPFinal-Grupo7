<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Preguntas del Juego</title>
</head>
<body>
{{> header}}

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="bg-dark text-white rounded-top-4 shadow-sm p-4 mb-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h1 class="display-5 fw-bold mb-1">
                            Preguntas del Juego
                        </h1>
                        <p class="lead mb-0 text-light">
                            Crea, edita o elimina las preguntas disponibles en el juego.
                        </p>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                        <a href="/PanelAdmin/mostrar" class="btn btn-outline-light mx-1 btn-lg">
                            Volver al Panel</a>

                        <div class="d-flex gap-2">
                            <a href="/Editor/verCategorias" class="btn btn-warning fw-bold btn-lg">
                                Categorías</a>
                            <form action="/Pregunta/crearPregunta" method="POST" class="m-0">
                                <input type="hidden" name="redirect" value="/PanelAdmin/verPreguntas">
                                <button type="submit" class="btn btn-success btn-lg">Crear pregunta</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            {{#hubo_preguntas}}
                <div class="card shadow-sm border-0 mt-2">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark text-uppercase fs-7">
                            <tr>
                                <th scope="col" class="ps-4 py-3" style="width: 45%;">Pregunta</th>
                                <th scope="col" class="py-3 text-center" style="width: 15%;">Categoría</th>
                                <th scope="col" class="pe-4 py-3 text-end" style="width: 25%;">Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#lista_preguntas}}
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="fw-semibold text-dark fs-5 d-block mb-1">{{texto}}</span>
                                        <div class="mt-2 d-flex flex-wrap gap-2">
                                            {{#respuestas}}
                                                <span class="badge {{#es_correcta}}bg-success{{/es_correcta}}{{^es_correcta}}bg-secondary{{/es_correcta}}">
                                                    {{texto}}
                                                </span>
                                            {{/respuestas}}
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                <span class="badge px-3 py-2 text-white" style="background-color: {{color}};">
                                    {{nombre}}
                                </span>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <form action="/PanelAdmin/verEditarPregunta" method="POST" class="m-0">
                                                <input type="hidden" name="id" value="{{id}}">
                                                <input type="hidden" name="redirect" value="/verPreguntas">
                                                <button type="submit"
                                                        class="btn btn-sm btn-warning fw-bold d-inline-flex align-items-center gap-1"
                                                        title="Editar contenido o respuestas">
                                                    Editar
                                                </button>
                                            </form>
                                            <form action="/PanelAdmin/eliminarPregunta" method="POST" class="m-0"
                                                  onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta pregunta de forma permanente?');">
                                                <input type="hidden" name="id_pregunta" value="{{id}}">
                                                <input type="hidden" name="redirect" value="/verPreguntas">
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger fw-bold d-inline-flex align-items-center gap-1"
                                                        title="Eliminar pregunta de la aplicación">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {{/lista_preguntas}}
                            </tbody>
                        </table>
                    </div>
                </div>
            {{/hubo_preguntas}}

            {{^hubo_preguntas}}
                <div class="card text-center shadow-sm border-0 p-5">
                    <div class="display-1 text-success mb-3">🎉</div>
                    <h3 class="fw-bold text-dark">¡No existen preguntas!</h3>
                    <p class="text-muted mb-0">No se encontraron preguntas cargadas en este momento.</p>
                </div>
            {{/hubo_preguntas}}

        </div>
    </div>
</main>

{{> footer}}
</body>
</html>