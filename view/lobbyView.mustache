<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Lobby</title>
</head>
<body>
{{> header}}

<main class="container py-4">

    <div class="row g-4">

        <!-- Perfil -->
        <div class="col-lg-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <a class="text-decoration-none text-light" href="/usuario/ver/{{usuario}}">
                        <div class="fotoperfil-arcoiris mx-auto mb-3">
                            <img src="/public/img/{{fotoPerfil}}"
                                 class="fotoperfil"
                                 width="120"
                                 height="120"
                                 alt="Perfil">
                        </div>

                        <h4 class="fw-bold fs-1">{{usuario}}</h4></a>

                    <span class="btn-dorado no-hover fs-6 mb-3 py-1 px-3">⭐ {{maestria}}</span>

                    <div class="puntaje py-2 mx-4">
                        <span class="text-light fs-4">MEJOR PUNTAJE<br></span>

                        <span class="fs-1 fw-bold">{{mejorPuntaje}}<br></span>
                        <span>puntos<br></span>

                        <span class="text-secondary">{{mejorFecha}}</span>
                    </div>

                    <div class="mx-4">
                        <a href="lobby/ranking" class="btn-dorado py-2 w-100 mt-4">
                            🏆 Ver ranking</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="col-lg-8">

            <div class="card shadow mb-4 position-relative">

                <div class="card-body text-center py-5">
                    <h1 class="mb-3 fs-1 fw-bold text-danger">¿Preguntamos?</h1>
                    <p class="lead text-light">Apreta el botón y proba hasta donde llegas con tu conocimiento.</p>
                    <!--Que vaya directamente a ruleta -->
                    <form action="/Pregunta/nuevaPartida" method="POST" class="m-0">
                        <input type="hidden" name="reiniciar_partida" value="1">
                        <button type="submit" class="buzzer">
                           <span class="buzzer__label">JUGAR</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-body text-center">
                    <p class="lead text-light">¿Querés aportar una pregunta al juego?</p>
                    <a href="/lobby/sugerirPregunta" class="btn-cyan py-2 px-5">
                        SUGERIR PREGUNTA</a>
                </div>
            </div>
        </div>

    </div>

    </div>

    </div>

</main>
</body>
</html>
