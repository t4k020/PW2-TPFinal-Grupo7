<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/public/css/lobby.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Lobby</title>
</head>
<body>
{{> header}}

<main class="container py-4">

    <div class="row g-4">

        <!-- Perfil -->
        <div class="col-lg-3">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <img src="/public/img/{{fotoPerfil}}"
                         class="rounded-circle mb-3"
                         width="120"
                         height="120"
                         alt="Perfil">

                    <h4>{{usuario}}</h4>

                    <hr>

                    <h5 class="text-primary">{{puntaje}} pts</h5>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="col-lg-9">

            <div class="card shadow mb-4 position-relative">

                <!-- Desktop -->
                <div class="position-absolute top-0 end-0 m-3 d-none d-md-block">
                    <a href="/ranking"
                       class="btn btn-warning btn-lg shadow">
                        🏆 Ranking
                    </a>
                </div>

                <div class="card-body text-center py-5">
                    <h2 class="mb-3">🎮 Nueva partida</h2>
                    <p class="lead">¿Listo para desafiar tus conocimientos?</p>

                    <a href="/index.php?controller=pregunta&method=list"
                       class="btn btn-primary btn-lg px-5">
                        JUGAR
                    </a>

                    <!-- Mobile -->
                    <div class="mt-3 d-md-none">
                        <a href="/ranking"
                           class="btn btn-warning btn-lg px-4">
                            🏆 Ranking
                        </a>
                    </div>
                </div>

            </div>

            <!-- Acciones secundarias -->
            <div class="row g-4">

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <h4>🪄 Trampitas</h4>

                            <p class="lead">
                                Disponibles: <strong>{{trampitas}}</strong>
                            </p>

                            <a href="/trampita/comprar"
                               class="btn btn-danger">
                                Comprar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <h4>❓ Crear pregunta</h4>

                            <p class="lead">
                                ¿Querés aportar una pregunta al juego?
                            </p>

                            <a href="/pregunta/sugerir"
                               class="btn btn-success">
                                Sugerir pregunta
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</main>
</body>
</html>
