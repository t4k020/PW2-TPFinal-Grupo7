<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Lobby</title>
</head>
<body>
{{> header}}

<main class="container mt-4">

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card shadow">
                <div class="card-body text-center">
                    <img src="/public/img/default-user.png" class="rounded-circle mb-3"
                         width="120" height="120" alt="Perfil">
                    <h4>{{usuario}}</h4>
                    <hr>
                    <h5 class="text-primary">{{puntaje}} pts</h5>
                    <p class="mb-0">Ranking #{{posicion}}</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <p class="lead">¿Listo para una nueva partida?</p>
                    <a href="/juego/iniciar" class="btn btn-primary btn-lg px-5">JUGAR</a>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <p class="lead">¿Queres crear tu propia pregunta?</p>
                    <a href="/pregunta/sugerir" class="btn btn-success btn-lg px-5">SUGERIR</a>
                </div>
            </div>

        </div>
        <div>
            <div class="card shadow mt-4">
                <div class="card-body text-center">
                    <p class="lead">Trampitas disponibles: {{trampitas}}</p>
                    <a href="/trampita/comprar" class="btn btn-warning btn-lg px-5">COMPRAR</a>
                </div>
            </div>
        </div>
    </div>

</main>
</body>
</html>
