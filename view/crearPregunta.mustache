<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Sugerir Pregunta</title>
</head>
<body>
{{> header}}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="card shadow border-0 rounded-3">

                <div id="headerCategoria" class="card-header text-white text-center py-3 border-0">
                    <span class="fw-bold fs-2 text-white m-0">Crear Pregunta</span>
                </div>

                <form action="{{#redirect}}/panelEditor/{{redirect}}{{/redirect}}
                {{^redirect}}/lobby/guardarSugerencia{{/redirect}}" method="POST">

                    <div class="card-body p-4 p-md-5">
                        <div class="mb-4 text-start">
                            <label for="texto" class="form-label fw-semibold text-secondary">Texto de la
                                Pregunta</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 py-3 shadow-sm"
                                   id="texto" name="texto_pregunta" placeholder="Ingrese su pregunta" required>
                        </div>

                        <div class="row g-3 mb-4 text-start">

                            <div class="col-md-4">
                                <label for="categoria_id" class="form-label fw-semibold
                                text-secondary">Categoría</label>
                                <select id="categoria_id" name="categoria_id" class="form-select
                                bg-light border-0 shadow-sm py-2" required>
                                    {{#categorias}}
                                        <option value="{{id}}" data-color="{{color}}">{{nombre}}</option>
                                    {{/categorias}}
                                </select>
                            </div>
                        </div>

                        <hr class="my-4">
                        <h4 class="card-title mb-4 fw-semibold text-start">Opciones de Respuesta</h4>

                        <div class="d-grid gap-3 text-start">
                            {{#opciones}}
                                <div class="input-group input-group-lg shadow-sm rounded border-0">
                                    <div class="input-group-text bg-white border-0 px-4">
                                        <input class="form-check-input" type="radio" name="respuesta_correcta"
                                               value="{{.}}" required style="transform: scale(1.3); cursor: pointer;">
                                        <span class="ms-2 text-success small fw-bold d-none d-sm-inline">Correcta</span>
                                    </div>

                                    <input type="text" class="form-control border-0 bg-light px-3 py-3 text-start"
                                           name="respuestas[{{.}}]" placeholder="Ingrese la opcion {{.}}" required>
                                </div>
                            {{/opciones}}
                        </div>
                        <hr class="my-5">

                        <div class="d-flex justify-content-end gap-3">
                            <a href="{{#redirect}}/panelEditor{{redirect}}{{/redirect}}
                                {{^redirect}}/lobby{{/redirect}}"
                               class="btn btn-outline-secondary btn-lg px-4 py-2 border-0 fw-medium">
                                Cancelar
                            </a>
                            <button id="submitColor" type="submit" class="btn btn-lg px-5 py-2 text-white fw-bold shadow-sm">
                                {{#redirect}}Crear{{/redirect}}{{^redirect}}Enviar{{/redirect}}
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</main>
{{> footer}}
</body>
<script src="/public/js/colorEditarCategoria.js"></script>
</html>