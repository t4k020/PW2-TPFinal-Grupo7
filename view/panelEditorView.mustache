<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <title>Preguntados - Panel Editor</title>
</head>
<body>
{{> header}}
<main class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card shadow h-100 border-dark">
                <div class="card-body text-center">
                    <div class="fotoperfil-arcoiris mx-auto mb-3">
                        <img src="/public/img/{{fotoPerfil}}"
                             class="fotoperfil"
                             width="120"
                             height="120"
                             alt="Perfil">
                    </div>
                    <h4 class="text-light">{{usuario}}</h4>
                    <span class="btn-dorado no-hover fs-6 mb-3 py-1 px-3">⭐ Editor de contenido</span>
                    <a href="/lobby" class="btn btn-outline-light btn-sm w-100">
                        🏠 Volver al Lobby
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">

            <div class="row g-4 mb-4">

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center py-5">
                            <h2 class="mb-3 text-cyan">🎮 Preguntas del Juego</h2>
                            <p class="lead text-light">
                                Administrar todas las preguntas disponibles del juego.
                            </p>
                            <a href="/panelEditor/verPreguntas"
                               class="btn btn-cyan btn-lg px-5 fw-bold">
                                VER PREGUNTAS
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow h-100">
                        <div class="card-body text-center py-5">
                            <h2 class="mb-3 text-warning">📝 Ver preguntas propuestas</h2>
                            <p class="lead text-light">
                                Preguntas propuestas por la comunidad, esperando revisión.
                            </p>
                            <a href="/panelEditor/verSugeridas"
                               class="btn btn-warning btn-lg px-5 fw-bold">
                                REVISAR PREGUNTAS
                            </a>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mx-0">
                    <div class="col-12">
                        <div class="card shadow">
                            <div class="card-body text-center py-4">
                                <h4 class="text-rosa">🚨 Preguntas Reportadas</h4>
                                <p class="text-light">
                                    Modificar o dar de baja preguntas denunciadas por los jugadores.
                                </p>

                                <a href="/panelEditor/verReportes"
                                   class="btn btn-danger px-4">
                                    Gestionar Reportes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
</body>
</html>