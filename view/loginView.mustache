<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preguntados - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="/public/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

{{> header}}

<main class="container">

    <div class="row justify-content-center mt-4">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body py-4 px-5">

                    <h1 class="text-center text-rosa mb-4">
                        Iniciar Sesión
                    </h1>

                    <form action="/login/procesar" method="POST">

                        <div class="mb-4">
                            <input
                                    type="text"
                                    name="username"
                                    class="form-control"
                                    placeholder="Usuario"
                                    required
                            >
                        </div>

                        <div class="mb-4">
                            <input
                                    type="password"
                                    name="password"
                                    class="form-control"
                                    placeholder="Contraseña"
                                    required
                            >
                        </div>

                        <button
                                type="submit"
                                class="btn btn-cyan mt-3 w-100">
                            Ingresar
                        </button>

                    </form>

                    <p class="text-center text-light pt-4 mx-0">
                        ¿Todavía no tenés cuenta?<br>
                        <a href="/register" class="text-decoration-none text-cyan fw-bold">
                            Registrate
                        </a>
                    </p>

                </div>

            </div>

        </div>

    </div>

</main>

</body>
</html>
