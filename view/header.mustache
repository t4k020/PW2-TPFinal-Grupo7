<style>
    header {
        position: relative;
        overflow: hidden;
        z-index: 20;

        min-height: 340px;
        padding: 2.5rem 5.5rem 0;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .logo {
        position: relative;
        z-index: 20;
        background: #0a0620;
        border: 3px solid #ffc93c;
        border-radius: 1.25rem;
        padding: 1.6rem 2.75rem 1.9rem;
    }

    .logo h1 {
        font-family: "Baloo 2", system-ui, sans-serif;
        font-size: clamp(2.75rem, 5vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0;

        background: linear-gradient(90deg, #ffc93c, #f62555, #17e9e0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;

        filter: drop-shadow(0 3px 0 #2b1064) drop-shadow(0 8px 16px rgba(0, 0, 0, .5));
    }

    /* ============ Cinta de noticias con la bajada ============ */
    .ticker {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 640px;
        margin: 1.25rem auto 2rem;
        overflow: hidden;
        border-top: 1px solid rgba(255, 201, 60, .35);
        border-bottom: 1px solid rgba(255, 201, 60, .35);
        padding: .5rem 0;
    }

    .ticker-track {
        display: flex;
        width: max-content;
        white-space: nowrap;
        animation: tickerScroll 16s linear infinite;
    }

    .ticker-texto {
        font-family: "Space Mono", monospace;
        font-size: .78rem;
        letter-spacing: .12em;
        color: #ffe08a;
        padding: 0 2rem;
    }

    @keyframes tickerScroll {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }

    .header-buttons .btn {
        font-size: .78rem;
        font-weight: bold;
    }

    .header-buttons .btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.06);
    }

    main.container {
        margin-top: -50px;
        position: relative;
        z-index: 10;
    }

    #mapa {
        height: 400px;
        width: 100%;
        margin-bottom: 15px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    @media (max-width: 767px) {
        header { padding: 2rem 1.75rem 0; }
    }

    @media (max-width: 490px) {
        .header-buttons .btn {
            padding: 0.25rem 0.6rem;
            font-size: 0.72rem;
            min-width: 90px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ticker-track {
            animation: none !important;
        }
    }
</style>

<header>

    {{#usuario}}
        <div class="header-buttons position-absolute top-0 start-0 p-2">
            {{#esAdmin}}
                <a href="/panelAdmin/verEstadisticasAdmin" class="btn btn-warning shadow fw-bold">
                    Panel Admin
                </a>
                <a href="/panelEditor/mostrar" class="btn btn-success text-dark">
                    Panel Editor
                </a>
            {{/esAdmin}}

            {{#esEditor}}
                <a href="/panelEditor/mostrar" class="btn btn-success text-dark">
                    Panel Editor
                </a>
            {{/esEditor}}
        </div>
        <div class="header-buttons position-absolute top-0 end-0 p-2">
            <a href="/login/logout" class="btn btn-logout text-light">
                Cerrar sesión</a>
        </div>
    {{/usuario}}

    <div class="logo">
        <a class="text-decoration-none" href="/lobby"><h1>PREGUNTADOS</h1></a>
    </div>

    <div class="ticker">
        <div class="ticker-track">
            <span class="ticker-texto">★ Aquí se forjan las leyendas del conocimiento ★</span>
            <span class="ticker-texto">★ Aquí se forjan las leyendas del conocimiento ★</span>
        </div>
    </div>
</header>
